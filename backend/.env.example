# Copy this to `.env` and set real values before deploying or running locally
GEMINI_API_KEY=
# FRONTEND_URL can be a comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000
# DATABASE_URL examples:
# SQLite (default - local): sqlite:///./financebot.db
# Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=
# PORT used by some hosting providers
PORT=8000
